/* iOS 权限弹窗说明（简体中文）。
 *
 * 这里的 key 与 Runner/Info.plist 中的同名 key 一一对应：构建时 Xcode 会把本文件里
 * 定义的值覆盖 Info.plist 中的默认值，系统据此在简体中文环境下弹出中文说明。
 *
 * ⚠️ 只写对应语种，不要写成「中文 + 英文」混排 —— 早期 Info.plist 里就是混排，
 * 英文系统用户第一眼看到的是中文，属于 App Store Guideline 5.1.1 的常见拒审点。
 * Info.plist 里保留英文作为默认值（developmentRegion = en），两边各管一种语言。
 */

/* 相机：用于手电筒（借用相机闪光灯），不拍照、不保存 */
"NSCameraUsageDescription" = "用于开启手电筒（借用相机闪光灯），不会拍摄或保存任何照片。";

/* 定位：指南针记录海拔与经纬度 */
"NSLocationWhenInUseUsageDescription" = "用于指南针记录当前位置的海拔与经纬度。";

/* 麦克风：噪音检测实时测分贝，不录音、不上传 */
"NSMicrophoneUsageDescription" = "用于噪音检测器实时测量环境分贝，不会录制或上传任何音频。";
